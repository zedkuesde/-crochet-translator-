generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tutorial {
  id        String   @id @default(uuid())
  name      String?
  rawText   String
  createdAt DateTime @default(now())
  steps     Step[]
}

model Step {
  id         String   @id @default(uuid())
  tutorialId String
  index      Int
  label      String
  createdAt  DateTime @default(now())

  tutorial Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  @@unique([tutorialId, index])
  @@index([tutorialId])
}

model CrochetTerm {
  id          String             @id @default(uuid())
  code        String             @unique
  label       String
  description String?
  imagePath   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  aliases     CrochetTermAlias[]
}

model CrochetTermAlias {
  id              String      @id @default(uuid())
  alias           String
  aliasNormalized String      @unique
  termId          String
  createdAt       DateTime    @default(now())
  term            CrochetTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([termId])
}
